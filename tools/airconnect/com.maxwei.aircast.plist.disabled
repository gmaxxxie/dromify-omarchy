<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.maxwei.aircast</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/airconnect/AirConnect.app/Contents/Resources/aircast-raw</string>
    <string>-Z</string>
    <string>-x</string>
    <string>__HOME__/airconnect/AirConnect.app/Contents/Resources/config_cast.xml</string>
    <string>-b</string>
    <string>__LAN_IP__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/aircast.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/aircast.log</string>
</dict></plist>
