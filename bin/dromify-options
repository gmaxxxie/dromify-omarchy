#!/bin/bash
# dromify-options - read and write Dromify's own option file.
#
# Why a file rather than the environment: the panel runs inside the Omarchy
# shell, and a shell process cannot change its own environment. Passing an
# option like DROMIFY_ALLOW_INSECURE_LAN on a Process's `command` would be
# worse — anything on the command line is world-readable via
# /proc/<pid>/cmdline, which is exactly the property the rest of Dromify is
# built to avoid. A state file with the same care as the output choice avoids
# both: dromify-api and dromify-dlna source it themselves.
#
# Usage:
#   dromify-options path                    -> the options file path
#   dromify-options read                    -> {"allowInsecureLan":bool}
#   dromify-options write <0|1>             -> set it (atomic, owner-only)
#   dromify-options get allow-insecure-lan  -> "0" | "1"
#
# Only options the helpers understand are written, and only their values; the
# file holds no credentials by construction.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dromify"
OPTIONS_FILE="$STATE_DIR/options.env"
KEY="DROMIFY_ALLOW_INSECURE_LAN"

fail() { echo "dromify-options: $*" >&2; exit 1; }

# Reads the value for $1 out of the file, printing nothing if it is absent or
# unreadable. A symlinked file is treated as absent rather than followed: the
# helpers are the only things that should be placing it, and a planted symlink
# could otherwise point at a file the user cares about.
read_option() {
  local key="$1" value=""
  [[ -f "$OPTIONS_FILE" && ! -L "$OPTIONS_FILE" ]] || return 0
  value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\([^[:space:]#]*\\).*/\\1/p" \
          -- "$OPTIONS_FILE" 2>/dev/null | tail -1)
  printf '%s' "$value"
}

# Writes the file from scratch: it only ever holds the options this script
# knows about, so an option removed from Dromify does not linger and change
# behaviour silently.
write_options() {
  local allow="$1"
  mkdir -p "$STATE_DIR" || fail "cannot create $STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  [[ -L "$OPTIONS_FILE" ]] && fail "$OPTIONS_FILE is a symlink; refusing to write"
  local tmp="$OPTIONS_FILE.tmp.$$"
  {
    printf '# Written by Dromify (%s). Read by bin/dromify-api and bin/dromify-dlna\n' "$(date -Iseconds)"
    printf '# so the panel can offer these without the shell process having to be\n'
    printf '# launched with them. Owner-only; holds no credentials.\n'
    printf '%s=%s\n' "$KEY" "$allow"
  } >"$tmp" || fail "cannot write $tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$OPTIONS_FILE" || fail "cannot replace $OPTIONS_FILE"
}

case "${1:-}" in
  path) printf '%s\n' "$OPTIONS_FILE" ;;
  read)
    allow="$(read_option "$KEY")"
    [[ "$allow" == "1" ]] && printf '{"allowInsecureLan":true}\n' || printf '{"allowInsecureLan":false}\n'
    ;;
  write)
    case "${2:-}" in
      0|1) write_options "$2"; printf '{"ok":true}\n' ;;
      *) fail "usage: dromify-options write <0|1>" ;;
    esac
    ;;
  get)
    case "${2:-}" in
      allow-insecure-lan) read_option "$KEY" ;;
      *) fail "usage: dromify-options get <allow-insecure-lan>" ;;
    esac
    ;;
  *)
    fail "usage: dromify-options <path|read|write <0|1>|get <name>>"
    ;;
esac
